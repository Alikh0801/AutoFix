{
  "expo": {
    "name": "AutoFix",
    "slug": "autofix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.autofix.app"
    },
    "android": {
      "package": "az.autofix.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0E1116"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E1116"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AutoFix yaxınlıqdakı köməyi tapmaq və sifarişini düzgün yerə göndərmək üçün yerini istifadə edir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FFB627",
          "defaultChannel": "requests"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "7198f5bf-7d0a-4ec7-800b-fa804e902f3e"
      }
    },
    "owner": "kheirkheberli",
    "updates": {
      "url": "https://u.expo.dev/7198f5bf-7d0a-4ec7-800b-fa804e902f3e"
    }
  }
}
